<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Full screen background color -->
    <item android:drawable="@color/splash_yellow" />

    <!-- Centered Logo - Adjust width/height as needed to "fit" your preference -->
    <item
        android:gravity="center"
        android:width="280dp"
        android:height="280dp">
        <bitmap
            android:src="@drawable/ic_splash_logo_content"
            android:gravity="center"
            android:filter="true" />
    </item>
</layer-list>
